:root {
    display: none;
}

.Background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.5;
    background-color: black;
}

.CentredBox {
    align-self: center;
    width: 50%;
    height: 50%;
    display: flex;
    flex-direction: column;
    opacity: 1;
}

.CentredBox > .row {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    flex-grow: 1;
}

.Image {
    flex-grow: 1;
    flex-basis: 0;
    height: 60%;
    margin: auto 10%;
}

.Unselected {
    height: 50%;
    opacity: 0.5;
}